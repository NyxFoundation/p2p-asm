import Libp2pAsm.Spec.Tls.Encode

namespace Libp2pAsm.Tests.Tls
open Spec.Tls

private def exts (input : Bytes) (s : Slice) : Except Error (Array Encode.Ext) := do
  let es ← extensions ⟨input,s.offset,s.offset+s.length⟩
  return es.map fun e => ⟨e.kind,e.data.bytes input⟩

/-- Exercise the typed public constructors with independently generated bytes;
all offsets are supplied by the separately executable parser. -/
def reencode (input : Bytes) : Except Error Bytes := do
  let v ← decode input (2^24-1)
  let bytes := fun f => (v.get f).bytes input
  let limit := 2^24-1
  match v.kind with
  | 1 => Encode.clientHello ⟨bytes .random,bytes .session,bytes .suites,
      ← exts input (v.get .extensions)⟩ limit
  | 2 => Encode.serverHello ⟨bytes .random,bytes .session,← exts input (v.get .extensions)⟩ limit
  | 8 => Encode.encryptedExtensions (← exts input (v.get .extensions)) limit
  | 13 => Encode.certificateRequest (← exts input (v.get .extensions)) limit
  | 11 => Encode.certificate (bytes .certificate) (← exts input (v.get .certificateExtensions)) limit
  | 15 => Encode.certificateVerify v.signatureScheme (bytes .signature) limit
  | 20 => Encode.finished (bytes .verifyData) limit
  | 4 => Encode.newSessionTicket v.lifetime v.ageAdd (bytes .ticketNonce) (bytes .ticket)
          (← exts input (v.get .extensions)) limit
  | _ => throw .unsupported

end Libp2pAsm.Tests.Tls
